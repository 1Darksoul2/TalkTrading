# # TalkTrading Community Microservice - Environment Configuration Example

# # Microservice Server Port
# PORT=8081

# # Spring Active Profile (dev for H2 in-memory, prod for PostgreSQL)
# SPRING_PROFILES_ACTIVE=dev

# # Database Configuration (Used in prod profile or Docker Compose)
# POSTGRES_DB=talktrading_community
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgrespassword
# POSTGRES_PORT=5433
# DB_URL=jdbc:postgresql://localhost:5433/talktrading_community
# DB_USERNAME=postgres
# DB_PASSWORD=postgrespassword
# DDL_AUTO=update

# # Storage Configuration
# STORAGE_TYPE=local
# STORAGE_LOCAL_DIR=./uploads

# # CORS Allowed Origins (Comma separated)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# # Frontend Configuration
# VITE_API_BASE_URL=http://localhost:8081
# TalkTrading Community Microservice - Environment Configuration Example



# Microservice Server Port
PORT=8081

# Spring Active Profile
# dev = H2 in-memory database
# prod = PostgreSQL database
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Configuration
# Used by Docker Compose / prod profile
POSTGRES_DB=talktrading_community
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5433

# Database Configuration
# When running Spring Boot directly on your host machine:
# PostgreSQL is exposed on localhost:5433
DB_URL=jdbc:postgresql://localhost:5433/talktrading_community
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DDL_AUTO=update

# Storage Configuration
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads

# CORS Allowed Origins
# Comma-separated list of frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend API Configuration
# Community service is exposed on localhost:8081
VITE_API_BASE_URL=http://localhost:8081