# TalkTrading settings for running on your computer (python start_all.py).
# Copy this file to .env (same folder) and fill in what you have. .env is never committed.
# On a server, the same settings go in deploy/.env instead (created by deploy/scripts/make_env.py).

# ── News (Finnhub) ─────────────────────────────────────────────────────────────
# Free key from https://finnhub.io (Dashboard → API key). Without it the News page is empty.
NEWS_PROVIDER=finnhub
NEWS_API_KEY=

# ── Prices and charts (TradingView) ────────────────────────────────────────────
# Nothing to set: prices come from TradingView's public data feed and the chart is
# TradingView's free embeddable widget. Neither needs an account or a key.

# ── Login secret (optional for local use) ──────────────────────────────────────
# Signs every login token; all services share it. Leave empty to use the development default.
SECRET_KEY=
