PROJECT_NAME="Social Content & Post Microservice"
VERSION="1.0.0"
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST_PORT=8004

# Database Configuration (Docker compose defaults to PostgreSQL service)
DATABASE_URL=postgresql://post_user:post_password_secret@postgres:5432/post_service_db
POSTGRES_USER=post_user
POSTGRES_PASSWORD=post_password_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=post_service_db

# Security & CORS
SECRET_KEY=super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173

# Inter-service Communication
USER_SERVICE_URL=http://user-service:8000

# Media Storage Configuration
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/app/uploads
