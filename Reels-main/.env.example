# Application Configuration
APP_NAME="Reel Microservice"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration
# Local SQLite default (relative to working directory):
DATABASE_URL="sqlite:///./reel.db"
# Production / Staging PostgreSQL example (using psycopg 3 binary driver):
# DATABASE_URL="postgresql+psycopg://reel_user:secure_password_here@localhost:5432/reel_db"
DB_ECHO=false

# Authentication & Security
# Shared secret for validating JWTs minted by the main identity/auth service
# In production, must be at least 32 characters long
JWT_SECRET_KEY="development_jwt_secret_key_reel_service_2026_dev_only"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Service-to-Service API Key for administrative & internal service calls
# Handled via X-Service-API-Key HTTP header
SERVICE_API_KEY="dev_internal_service_key_reel_2026_dev_only"

# CORS Configuration (JSON array of allowed origins)
# For web frontend integration (e.g. Next.js, React on localhost:3000):
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "*"]

# External Media & CDN Configuration
MEDIA_BASE_URL="https://storage.example.com/videos"
ALLOWED_MEDIA_DOMAINS=["storage.example.com", "cdn.example.com", "localhost"]

# Rate Limiting & Abuse Prevention (in-memory sliding window)
RATE_LIMIT_PER_MINUTE=120

# Feed Advertisement Settings
AD_FREQUENCY_INTERVAL=4
